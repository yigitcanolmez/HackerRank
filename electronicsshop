    static int getMoneySpent(int[] keyboards, int[] drives, int b) {
        
        int maxSpent = -1;
        
       for (int i = 0; i < keyboards.Length; i++) {
           
        for (int j = 0; j < drives.Length; j++) {
            int price = keyboards[i] + drives[j];  

            
            if (price <= b && price > maxSpent) {
                maxSpent = price; 
            }
        }
    }
        return maxSpent;
    }
